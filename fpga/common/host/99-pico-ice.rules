#
# 99-pico-ice.rules — udev rules for the pico-ice RP2040 development board.
#
# INSTALL:
#   sudo cp fpga/host/99-pico-ice.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Or use the Makefile target: sudo make -C fpga install-udev
#
# WHAT THIS DOES:
#
# 1. Blocks usb_storage from binding to the RP2040 BOOTSEL mass-storage
#    interface (2e8a:0003) and to any spurious mass-storage interface that the
#    pico-ice MicroPython firmware (1209:b1c0) may briefly expose when its USB
#    stack crashes under heavy PIO/SPI load.
#
#    If usb_storage binds during a crash, the kernel usb-storage thread enters
#    uninterruptible sleep (state D) and deadlocks — the xHCI controller gets
#    confused, replug doesn't help, and a full system reboot is required.
#
#    The interface-level rule (SUBSYSTEM=="usb", DRIVER=="usb-storage") prevents
#    binding without affecting CDC-ACM enumeration, so /dev/ttyACM0 comes up
#    normally after the RP2040 resets its USB stack.
#
#    NOTE: This intentionally also blocks BOOTSEL mass-storage binding during
#    normal use. To flash firmware via picotool/uf2, use:
#      picotool load firmware.uf2 --force
#    which speaks the BOOTSEL protocol directly without needing /dev/sda.
#
# 2. Sets UDISKS_IGNORE=1 to prevent desktop automounters (udisks2, GNOME, KDE)
#    from popping up mount dialogs.

# pico-ice running MicroPython (normal operating mode) — suppress automounter
SUBSYSTEM=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="b1c0", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0005", ENV{UDISKS_IGNORE}="1"

# pico-ice MicroPython — block usb_storage if it ever exposes a mass-storage
# interface during a USB stack crash (prevents kernel deadlock in D state)
SUBSYSTEM=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="b1c0", DRIVER=="usb-storage", OPTIONS+="ignore_device"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0005", DRIVER=="usb-storage", OPTIONS+="ignore_device"

# RP2040 BOOTSEL mode — suppress automounter
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0003", ENV{UDISKS_IGNORE}="1"

# RP2040 BOOTSEL mode — block usb_storage from binding (prevents /dev/sda
# appearing and shifting ttyACM numbering away from ttyACM0).
# Normally active. Disable temporarily with: sudo make -C fpga enable-bootsel
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0003", DRIVER=="usb-storage", OPTIONS+="ignore_device"
