# pico-ice RP2040 (MicroPython) — allow non-root USB reset & sysfs control
# Install: sudo cp this-file /etc/udev/rules.d/ && sudo udevadm control --reload-rules
#
# Matches the pico-ice RP2040 running MicroPython (VID 1209, PID b1c0).
# Grants the "plugdev" group write access to the USB device node and the
# sysfs "authorized" attribute, so usb_recover.sh works without sudo.

# Device node permissions
SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="b1c0", MODE="0666", GROUP="plugdev"

# ttyACM permissions
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="b1c0", MODE="0666", GROUP="plugdev", SYMLINK+="pico-ice"
