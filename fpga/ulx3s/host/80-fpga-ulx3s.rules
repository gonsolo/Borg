#
# ULX3S udev rules — allow members of the "uucp" group to access
# the onboard FT231X USB-serial/JTAG chip without root.
# (Arch Linux uses "uucp" instead of "dialout")
#
# Install with:  make install-udev   (from fpga/ulx3s/)
# Or manually:   sudo cp 80-fpga-ulx3s.rules /etc/udev/rules.d/
#                sudo udevadm control --reload-rules && sudo udevadm trigger
# Then replug the board.

# USB-serial TTY device (/dev/ttyUSB0)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", \
  MODE="664", GROUP="uucp"

# Raw libusb access for openFPGALoader JTAG programming
ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", \
  GROUP="uucp", MODE="666"
