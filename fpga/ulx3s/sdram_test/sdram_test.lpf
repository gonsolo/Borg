# ULX3S pin constraints for sdram_test
# SDRAM: IS42S16160G-7TL (32 MB, 16-bit, 4 banks)
# Pin assignments taken verbatim from emard/ulx3s ulx3s_v20.lpf

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# 25 MHz oscillator
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# LEDs (D0–D7)
LOCATE COMP "led[0]" SITE "B2"; IOBUF PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[1]" SITE "C2"; IOBUF PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[2]" SITE "C1"; IOBUF PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[3]" SITE "D2"; IOBUF PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[4]" SITE "D1"; IOBUF PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[5]" SITE "E2"; IOBUF PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[6]" SITE "E1"; IOBUF PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[7]" SITE "H3"; IOBUF PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# Buttons — btn[0]=PWRn (active-low, pull-up), btn[1..6] active-high
LOCATE COMP "btn[0]" SITE "D6";  IOBUF PORT "btn[0]" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[1]" SITE "R1";  IOBUF PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[2]" SITE "T1";  IOBUF PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[3]" SITE "R18"; IOBUF PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[4]" SITE "V1";  IOBUF PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[5]" SITE "U1";  IOBUF PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[6]" SITE "H16"; IOBUF PORT "btn[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;

# SDRAM — IS42S16160G-7TL
LOCATE COMP "sdram_clk"    SITE "F19"; IOBUF PORT "sdram_clk"    PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
LOCATE COMP "sdram_cke"    SITE "F20"; IOBUF PORT "sdram_cke"    PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_csn"    SITE "P20"; IOBUF PORT "sdram_csn"    PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_wen"    SITE "T20"; IOBUF PORT "sdram_wen"    PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_rasn"   SITE "R20"; IOBUF PORT "sdram_rasn"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_casn"   SITE "T19"; IOBUF PORT "sdram_casn"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[0]"   SITE "M20"; IOBUF PORT "sdram_a[0]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[1]"   SITE "M19"; IOBUF PORT "sdram_a[1]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[2]"   SITE "L20"; IOBUF PORT "sdram_a[2]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[3]"   SITE "L19"; IOBUF PORT "sdram_a[3]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[4]"   SITE "K20"; IOBUF PORT "sdram_a[4]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[5]"   SITE "K19"; IOBUF PORT "sdram_a[5]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[6]"   SITE "K18"; IOBUF PORT "sdram_a[6]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[7]"   SITE "J20"; IOBUF PORT "sdram_a[7]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[8]"   SITE "J19"; IOBUF PORT "sdram_a[8]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[9]"   SITE "H20"; IOBUF PORT "sdram_a[9]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[10]"  SITE "N19"; IOBUF PORT "sdram_a[10]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[11]"  SITE "G20"; IOBUF PORT "sdram_a[11]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_a[12]"  SITE "G19"; IOBUF PORT "sdram_a[12]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_ba[0]"  SITE "P19"; IOBUF PORT "sdram_ba[0]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_ba[1]"  SITE "N20"; IOBUF PORT "sdram_ba[1]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_dqm[0]" SITE "U19"; IOBUF PORT "sdram_dqm[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_dqm[1]" SITE "E20"; IOBUF PORT "sdram_dqm[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[0]"   SITE "J16"; IOBUF PORT "sdram_d[0]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[1]"   SITE "L18"; IOBUF PORT "sdram_d[1]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[2]"   SITE "M18"; IOBUF PORT "sdram_d[2]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[3]"   SITE "N18"; IOBUF PORT "sdram_d[3]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[4]"   SITE "P18"; IOBUF PORT "sdram_d[4]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[5]"   SITE "T18"; IOBUF PORT "sdram_d[5]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[6]"   SITE "T17"; IOBUF PORT "sdram_d[6]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[7]"   SITE "U20"; IOBUF PORT "sdram_d[7]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[8]"   SITE "E19"; IOBUF PORT "sdram_d[8]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[9]"   SITE "D20"; IOBUF PORT "sdram_d[9]"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[10]"  SITE "D19"; IOBUF PORT "sdram_d[10]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[11]"  SITE "C20"; IOBUF PORT "sdram_d[11]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[12]"  SITE "E18"; IOBUF PORT "sdram_d[12]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[13]"  SITE "F18"; IOBUF PORT "sdram_d[13]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[14]"  SITE "J18"; IOBUF PORT "sdram_d[14]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "sdram_d[15]"  SITE "J17"; IOBUF PORT "sdram_d[15]"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

## FTDI UART (FPGA TX → PC)
LOCATE COMP "ftdi_rxd" SITE "L4";
IOBUF PORT "ftdi_rxd" IO_TYPE=LVCMOS33;
