# ULX3S pin constraints for pmod_test — ORIGINAL orientation
# Pin 1 (CS0) at GP24 (top), pin 4 (SCK) at GP21 (bottom)
# PMOD now shifted down so power pins align with J2 GND/3.3V+

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

LOCATE COMP "rst_n"  SITE "D6"; IOBUF PORT "rst_n"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ROW SWAP: PMOD row 1 on GN, row 2 on GP
LOCATE COMP "pmod_cs0" SITE "D16"; IOBUF PORT "pmod_cs0" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=8;  # GN24
LOCATE COMP "pmod_sd0" SITE "C17"; IOBUF PORT "pmod_sd0" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;  # GN23
LOCATE COMP "pmod_sd1" SITE "C15"; IOBUF PORT "pmod_sd1" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;  # GN22 ← MISO
LOCATE COMP "pmod_sck" SITE "D17"; IOBUF PORT "pmod_sck" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;  # GN21
# Row 2 (GP): SD2=GP24, SD3=GP23, CS1=GP22, CS2=GP21
LOCATE COMP "pmod_sd2" SITE "C16"; IOBUF PORT "pmod_sd2" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;  # GP24
LOCATE COMP "pmod_sd3" SITE "B17"; IOBUF PORT "pmod_sd3" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;  # GP23
LOCATE COMP "pmod_cs1" SITE "B15"; IOBUF PORT "pmod_cs1" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;  # GP22
LOCATE COMP "pmod_cs2" SITE "C18"; IOBUF PORT "pmod_cs2" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;  # GP21

# LEDs
LOCATE COMP "led[0]" SITE "B2"; IOBUF PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[1]" SITE "C2"; IOBUF PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[2]" SITE "C1"; IOBUF PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[3]" SITE "D2"; IOBUF PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[4]" SITE "D1"; IOBUF PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[5]" SITE "E2"; IOBUF PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[6]" SITE "E1"; IOBUF PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[7]" SITE "H3"; IOBUF PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# Buttons
LOCATE COMP "btn[0]" SITE "R1";  IOBUF PORT "btn[0]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[1]" SITE "T1";  IOBUF PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[2]" SITE "R18"; IOBUF PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[3]" SITE "V1";  IOBUF PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[4]" SITE "U1";  IOBUF PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[5]" SITE "H16"; IOBUF PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
