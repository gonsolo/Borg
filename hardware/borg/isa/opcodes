# The Borg shader ISA, in the format of riscv-opcodes: a name, its operand fields
# (fields.csv) and the fixed bits. Every bit of a word is an operand or fixed.
# hardware/borg/isa/gen.py generates the Scala decoder constants, borg_isa.h and
# the compiler's opcodes.rs from it.
#
# f3 selects the operand read from the uniform window (k + 1: operand k), unless
# an instruction says otherwise. Registers hold raw bits; tests against zero
# compare the raw bits, so FP -0.0 is non-zero.

# R4-type: opcode 0x04, funct2 at 26..25 (1 was FTEX, retired).
fmadd   rd rs1 rs2 rs3 f3   26..25=0 6..0=0x04
# TEX rd, u, v, ctl: rd..rd+3 = RGBA (rd <= 28); docs/B2_texture_unit.md.
tex     rd rs1 rs2 rs3 f3   26..25=2 6..0=0x04
# TEXA w, lod, dref: this lane's extra arguments for the TEX after it.
texa    rs1 rs2 rs3 f3      26..25=3 11..7=0 6..0=0x04

# R-type: opcode 0x00, funct7 at 31..25 (0x0C was FTEX, retired).
fadd    rd rs1 rs2 f3       31..25=0x00 6..0=0x00
fmul    rd rs1 rs2 f3       31..25=0x04 6..0=0x00
fneg    rd rs1 f3           31..25=0x06 24..20=0 6..0=0x00
# FMOV: a plain copy, how a window word gets into a register.
fmov    rd rs1 f3           31..25=0x52 24..20=0 6..0=0x00
fstep   rd rs1 f3           31..25=0x08 24..20=0 6..0=0x00
frcp    rd rs1 f3           31..25=0x0A 24..20=0 6..0=0x00
iadd    rd rs1 rs2 f3       31..25=0x0E 6..0=0x00
# Shifts take the amount from rs2 & 31; ISHR is arithmetic, ISRL logical.
ishl    rd rs1 rs2 f3       31..25=0x10 6..0=0x00
ishr    rd rs1 rs2 f3       31..25=0x12 6..0=0x00
imul    rd rs1 rs2 f3       31..25=0x14 6..0=0x00
isub    rd rs1 rs2 f3       31..25=0x30 6..0=0x00
iand    rd rs1 rs2 f3       31..25=0x32 6..0=0x00
ior     rd rs1 rs2 f3       31..25=0x34 6..0=0x00
ixor    rd rs1 rs2 f3       31..25=0x36 6..0=0x00
# Comparisons write 0 or 1, so they feed BRZ, BRNZ and EXPUSH directly.
islt    rd rs1 rs2 f3       31..25=0x38 6..0=0x00
iseq    rd rs1 rs2 f3       31..25=0x3A 6..0=0x00
i2f     rd rs1 f3           31..25=0x16 24..20=0 6..0=0x00
# F2I truncates.
f2i     rd rs1 f3           31..25=0x18 24..20=0 6..0=0x00
# F2H, H2F: FP16 in the low 16 bits of a register, rounded to nearest even.
f2h     rd rs1 f3           31..25=0x54 24..20=0 6..0=0x00
h2f     rd rs1 f3           31..25=0x56 24..20=0 6..0=0x00
# FRCP, FRSQ and FSRGB are table lookups.
frsq    rd rs1 f3           31..25=0x1A 24..20=0 6..0=0x00
fsrgb   rd rs1 f3           31..25=0x1C 24..20=0 6..0=0x00
# Derivatives across the 2x2 quad: lane 1 - lane 0, lane 2 - lane 0.
ddx     rd rs1 fine f3      31..25=0x1E 6..0=0x00
ddy     rd rs1 fine f3      31..25=0x20 6..0=0x00
# LOAD, STORE: rs1 is a word index, the address LS_BASE + (rs1 << 2).
load    rd rs1 f3           31..25=0x22 24..20=0 6..0=0x00
store   rs1 rs2 private f3  31..25=0x24 6..0=0x00
# BRZ, BRNZ: if rs1 is (not) zero, jump by offset words from the branch (-512..511).
brz     rs1 offset f3       31..25=0x26 6..0=0x00
brnz    rs1 offset f3       31..25=0x28 6..0=0x00
# Execution mask of the quad: EXPUSH pushes and ands with rs1 != 0 per lane,
# EXELSE flips to the else arm, EXPOP pops; EXANY rd = any lane active.
expush  rs1 f3              31..25=0x2A 24..20=0 11..7=0 6..0=0x00
exelse  f3                  31..25=0x2C 24..15=0 11..7=0 6..0=0x00
expop   f3                  31..25=0x2E 24..15=0 11..7=0 6..0=0x00
# BARRIER: compute only; the sequencer runs every quad of the workgroup up to it.
barrier f3                  31..25=0x3C 24..15=0 11..7=0 6..0=0x00
exany   rd f3               31..25=0x3E 24..15=0 6..0=0x00
# ZTEST: the depth and stencil test now, with the depth in r29 (early tests).
ztest   f3                  31..25=0x40 24..15=0 11..7=0 6..0=0x00
# SOUT: rs2 is output component index of this invocation (draw front end).
sout    rs2 index f3        31..25=0x42 6..0=0x00
# FATTR: component aindex of the triangle's three vertices to rd..rd+2 (rd <= 29).
fattr   rd aindex           31..25=0x44 14..12=0 6..0=0x00
# SMASK: this lane's coverage mask; ATTIDX: the attachment this pass renders.
smask   rd f3               31..25=0x46 24..15=0 6..0=0x00
attidx  rd f3               31..25=0x48 24..15=0 6..0=0x00
isrl    rd rs1 rs2 f3       31..25=0x4A 6..0=0x00
isltu   rd rs1 rs2 f3       31..25=0x4C 6..0=0x00
# TLD: word f3 of the colour attachment's current value at this pixel (raw formats).
tld     rd f3               31..25=0x4E 24..15=0 6..0=0x00
# JMP: unconditional, by joffset words from the jump (18 bits, signed).
jmp     joffset             31..25=0x50 6..0=0x00

# HALT is the all-zero word.
$pseudo_op fadd halt        31..0=0
