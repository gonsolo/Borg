//
// SoC Top-Level — SystemRDL 2.0 Address Map
//
// Composes all peripherals at their CPU-visible base addresses.
//
// Address computation (TinyQV convention):
//   User peripherals: USER_BASE + select × 1024
//   USER_BASE = 0x08000000
//   GPIO:  select=1 → 0x08000400
//   UART:  select=2 → 0x08000800
//   Borg:  select=3 → 0x08000C00
//   DRAM: separate region at 0x01001000

addrmap soc {
    name = "Borg SoC";
    desc = "Top-level address map for the Borg SoC.  Instantiates all
            peripherals at their CPU-visible base addresses.";

    gpio_map gpio @ 0x08000400;
    uart_map uart @ 0x08000800;
    borg_gpu borg @ 0x08000C00;
    dram_map dram @ 0x01001000;
};
