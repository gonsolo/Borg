// --- Sequencer: frag shader DRAM address (Step 31) ---
reg seq_frag_addr_reg_t {
    name = "Sequencer Frag Shader Address";
    desc = "20-bit DRAM byte address of the fragment shader binary.
            The sequencer DMA-loads this shader into IMEM after the rast shader
