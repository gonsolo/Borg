// --- Sequencer: clear color low word (Step 31) ---
reg seq_clear_lo_reg_t {
    name = "Sequencer Clear Color Low";
    desc = "Packed {B[31:16], Z[15:0]} clear color for tile buffer pre-fill.
            The sequencer writes this to all 16 tile buffer entries before the
            first triangle on each tile.  nogen: decoded in Borg.scala.";

    field {
        sw = rw; hw = r;
