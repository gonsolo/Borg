reg seq_setup_base_reg_t {
    name = "Sequencer Setup Store Base Address";
    desc = "20-bit DRAM byte address of the TBR setup store region.
            Each triangle's 31 uniforms are stored at stride 128 bytes.
            Written by firmware at frame start.  nogen: decoded in Borg.scala.";

    field {
