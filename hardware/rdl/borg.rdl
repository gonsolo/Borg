// --- Performance counter (present-phase decomposition) ---
// 32-bit free-running cycle counter.  Counter logic lives in Borg.scala
// (wirePerf): reset at the rising edge of sequencer-busy, accumulated while its
// gate is high during the render, frozen when the sequencer goes idle — so SW
// reads the previous frame's exact cycle breakdown.  sw=r/hw=w exposes the
// Borg-side counter value to MMIO read, mirroring the status register.
reg perf_counter_reg_t {
    name = "Performance Counter";
    desc = "32-bit GPU cycle counter for present-phase decomposition.";

    field {
        sw = r; hw = w;
        desc = "32-bit cycle count (gate-dependent, per sequencer run).";
    } value[32] = 0;
};

// --- 16-bit FP register (stored in 32-bit word, upper bits ignored on write) ---
reg gpr_reg_t {
    name = "General Purpose Register";
    desc = "Shader register, one datapath float (FP32 in every current
            configuration; an FP16 build uses the low 16 bits and reads
            them back zero-extended).  32 entries: r0–r31.";

    field {
        sw = rw; hw = rw;
        desc = "Register value.";
    } value[32] = 0;
};

// --- 32-bit instruction memory word ---
reg imem_reg_t {
    name = "Instruction Memory";
    desc = "32-bit RISC-V instruction word.  72 slots (0–71).  Write-only from
            MMIO; the FPU fetches instructions from here during execution.";

    field {
        sw = w; hw = r;
        desc = "32-bit instruction (RISC-V R-type or R4-type encoding).";
    } instruction[32] = 0;
};

// --- 16-bit uniform buffer entry ---
reg uniform_reg_t {
    name = "Uniform Buffer Entry";
    desc = "Uniform value, one datapath float.  32 entries visible via MMIO (one page);
            CONTROL.uniform_write_page selects which hardware page (0 or 1)
            these writes target.  The GPU reads the page selected by the
            Command FIFO entry's uniformPage field.";

    field {
        sw = w; hw = r;
        desc = "Uniform value.";
    } value[32] = 0;
};


// --- Compute dispatch (BorgConfig.computeEnabled) ---
reg compute_ctrl_reg_t {
    name = "Compute Dispatch Control / Status";
    desc = "Write bit 0 = 1 to start a dispatch of COMPUTE_GROUPS workgroups,
            each running COMPUTE_LOCAL.count invocations of the shader at
            COMPUTE_PC. Load IMEM, LS_BASE and any uniforms first; the
            sequencer overwrites uniforms u29/u30/u31 of page 0 with the
            workgroup ID (x/y/z, raw integers) before each workgroup.
            Reading returns bit 0 = done (sticky, cleared by the next start),
            bit 1 = busy, bit 2 = compute hardware present.
            nogen: decoded in Borg.scala.";

    field {
        sw = w; hw = r;
        singlepulse;
        desc = "Bit 0: Start dispatch (self-clearing pulse).";
    } start[1] = 0;

    field {
        sw = w; hw = na;
    } RSVD[31] = 0;
};

reg compute_pc_reg_t {
    name = "Compute Shader Start PC";
    desc = "IMEM word index of the compute shader's first instruction.";

    field {
        sw = w; hw = r;
        desc = "Bits 5:0: start PC.";
    } pc[6] = 0;

    field {
        sw = w; hw = na;
    } RSVD[26] = 0;
};

reg compute_groups_xy_reg_t {
    name = "Compute Workgroup Count X/Y";
    desc = "vkCmdDispatch groupCountX/Y. A zero count in any dimension
            dispatches nothing and completes immediately.";

    field { sw = w; hw = r; desc = "Bits 15:0: groupCountX."; }  x[16] = 0;
    field { sw = w; hw = r; desc = "Bits 31:16: groupCountY."; } y[16] = 0;
};

reg compute_groups_z_reg_t {
    name = "Compute Workgroup Count Z";
    desc = "vkCmdDispatch groupCountZ.";

    field { sw = w; hw = r; desc = "Bits 15:0: groupCountZ."; } z[16] = 0;
    field { sw = w; hw = na; } RSVD[16] = 0;
};

reg compute_local_reg_t {
    name = "Compute Workgroup Size";
    desc = "The shader's LocalSize. count must equal x*y*z (the driver
            computes it; the hardware has no multiplier for it) and be at most
            128, Vulkan's minimum maxComputeWorkGroupInvocations. Each lane
            reads its invocation's IDs as raw integers: r30 =
            LocalInvocationIndex, r31 = LocalInvocationID packed as
            x | y << 10 | z << 20.";

    field { sw = w; hw = r; desc = "Bits 7:0: local size x."; }        x[8] = 0;
    field { sw = w; hw = r; desc = "Bits 15:8: local size y."; }       y[8] = 0;
    field { sw = w; hw = r; desc = "Bits 23:16: invocation count."; }  count[8] = 0;
    field { sw = w; hw = na; } RSVD[8] = 0;
};


// ============================================================================
// Address map
// ============================================================================

addrmap borg_gpu {
    name = "Borg GPU";
    desc = "Borg minimal FP16 shading processor — SystemRDL 2.0 register map.
            1024-byte address space (byte 0x000–0x3FF), 32-bit aligned.
            Base address is USER_BASE + USER_PERI_BORG × 1024 = 0x08000C00.";

    default hw = r;
    default sw = rw;

    // ---- Register File: 0x000 – 0x07C (32 entries × 4 bytes) ----
    gpr_reg_t gpr[32] @ 0x000 += 0x4;

    // ---- Instruction Memory: 0x080 – 0x19C (72 entries × 4 bytes) ----
    imem_reg_t imem[72] @ 0x080 += 0x4;

    // ---- Pixel Iterator Position / Advance: 0x1A4 ----
    iter_reg_t iter @ 0x1A4;

    // ---- Control (write only): 0x1A8 ----
    control_reg_t control;

    // ---- Status (read only): 0x1AC ----
    status_reg_t status;

    // ---- Uniform Buffer (1 page × 32 entries): 0x1B0 – 0x22C ----
    uniform_reg_t uniform[32] += 0x4;

    // ---- Tile Buffer Control: 0x230 ----
    tile_ctrl_reg_t tile_ctrl;

    // ---- Tile Buffer RG Read / Write Trigger: 0x234 ----
    tile_rg_reg_t tile_rg;

    // ---- Tile Buffer BZ Read / Shadow Latch: 0x238 ----
    tile_bz_reg_t tile_bz;

    // ---- Command FIFO Enqueue: 0x23C ----
    cmd_enqueue_reg_t cmd_enqueue;

    // tex_uv removed (no hw ports; firmware never writes it)

    // ---- Texture Address (HW-computed): 0x240 ----
    tex_addr_reg_t tex_addr;

    // ---- Texture Configuration: 0x244 ----
    tex_config_reg_t tex_config;

    // ---- Fragment Shader Start PC: 0x248 ----
    frag_pc_reg_t frag_pc;

    // ---- DMA DRAM Base Address: 0x210 — nogen on FPGA (hasDMA=false) ----
    dma_dram_reg_t dma_dram;
    dma_dram->nogen = true;

    // ---- DMA Configuration + Trigger: 0x214 — nogen on FPGA (hasDMA=false) ----
    dma_config_reg_t dma_config;
    dma_config->nogen = true;

    // ---- Flush Framebuffer Base Address: 0x218 — nogen (decoded in Borg.scala) ----
    flush_fb_base_reg_t flush_fb_base;
    flush_fb_base->nogen = true;

    // ---- Flush Z-buffer Base Address: 0x258 — nogen (decoded in Borg.scala) ----
    flush_zb_base_reg_t flush_zb_base;
    flush_zb_base->nogen = true;

    // ---- Flush Framebuffer Width: 0x25C — nogen (decoded in Borg.scala) ----
    flush_width_reg_t flush_width;
    flush_width->nogen = true;

    // ---- Sequencer Descriptor Base Address: 0x220 — nogen (decoded in Borg.scala) ----
    seq_desc_base_reg_t seq_desc_base;
    seq_desc_base->nogen = true;

    // ---- Sequencer Trigger: 0x224 — nogen (decoded in Borg.scala) ----
    seq_trigger_reg_t seq_trigger;
    seq_trigger->nogen = true;

    // ---- Sequencer Vertex Shader Address: 0x228 — nogen (Step 29.1) ----
    seq_vert_addr_reg_t seq_vert_addr;
    seq_vert_addr->nogen = true;

    // ---- Sequencer Vertex Shader Length: 0x22C — nogen (Step 29.1) ----
    seq_vert_len_reg_t seq_vert_len;
    seq_vert_len->nogen = true;

    // ---- Sequencer Setup Shader Address: 0x230 — nogen (Step 29.2) ----
    seq_setup_addr_reg_t seq_setup_addr;
    seq_setup_addr->nogen = true;

    // ---- Sequencer Setup Shader Length: 0x234 — nogen (Step 29.2) ----
    seq_setup_len_reg_t seq_setup_len;
    seq_setup_len->nogen = true;

    // ---- Sequencer Inverse Width: 0x238 — nogen (Step 30.1c) ----
    seq_inv_width_reg_t seq_inv_width;
    seq_inv_width->nogen = true;

    // ---- Sequencer Triangle Count: 0x23C — nogen (Step 31) ----
    seq_tri_count_reg_t seq_tri_count;
    seq_tri_count->nogen = true;

    // ---- Sequencer Rast Shader Address: 0x240 — nogen (Step 31) ----
    seq_rast_addr_reg_t seq_rast_addr;
    seq_rast_addr->nogen = true;

    // ---- Sequencer Rast Shader Length: 0x244 — nogen (Step 31) ----
    seq_rast_len_reg_t seq_rast_len;
    seq_rast_len->nogen = true;

    // ---- Sequencer Frag Shader Address: 0x248 — nogen (Step 31) ----
    seq_frag_addr_reg_t seq_frag_addr;
    seq_frag_addr->nogen = true;

    // ---- Sequencer Frag Shader Length: 0x24C — nogen (Step 31) ----
    seq_frag_len_reg_t seq_frag_len;
    seq_frag_len->nogen = true;

    // ---- Sequencer Clear Color Low: 0x250 — nogen (Step 31) ----
    seq_clear_lo_reg_t seq_clear_lo;
    seq_clear_lo->nogen = true;

    // ---- Sequencer Clear Color High: 0x254 — nogen (Step 31) ----
    seq_clear_hi_reg_t seq_clear_hi;
    seq_clear_hi->nogen = true;

    // ---- Sequencer Framebuffer Base Address: 0x258 — nogen (Step 31.4) ----
    seq_fb_base_reg_t seq_fb_base;
    seq_fb_base->nogen = true;

    // ---- Sequencer Tiles Per Row: 0x25C — nogen (Step 31.4) ----
    seq_tiles_per_row_reg_t seq_tiles_per_row;
    seq_tiles_per_row->nogen = true;

    // ---- Sequencer Bin List Base: 0x260 — nogen (Step 32.2) ----
    seq_bin_base_reg_t seq_bin_base;
    seq_bin_base->nogen = true;

    // ---- Sequencer Bin Row Bytes: 0x264 — nogen (Step 32.2) ----
    seq_bin_row_bytes_reg_t seq_bin_row_bytes;
    seq_bin_row_bytes->nogen = true;

    // ---- Sequencer Setup Store Base: 0x268 — nogen (Step 32.3) ----
    seq_setup_base_reg_t seq_setup_base;
    seq_setup_base->nogen = true;

    // ---- Depth test configuration — fully generated (hw=r, Borg reads
    //      io.hw.depth_cfg_compare_op / _write_en). Reset values reproduce
    //      the historical hardcoded LESS + always-write behaviour. ----
    depth_cfg_reg_t depth_cfg;

    // ---- Blend configuration — fully generated (hw=r, Borg reads
    //      io.hw.blend_cfg_* / blend_const_*). Reset 0 = blending disabled,
    //      i.e. the historical unconditional overwrite. ----
    blend_cfg_reg_t blend_cfg;
    blend_const_reg_t blend_const;

    // ---- Stencil configuration — fully generated (hw=r). Reset 0 = stencil
    //      disabled, i.e. the historical no-stencil behaviour. ----
    stencil_cfg_reg_t stencil_cfg;
    stencil_face_reg_t stencil_front;
    stencil_face_reg_t stencil_back;
    plane_clear_reg_t plane_clear;

    // ---- Face culling — fully generated (hw=r). Reset = cull back faces,
    //      the historical hardcoded behaviour. ----
    cull_cfg_reg_t cull_cfg;

    // ---- Scissor rectangle — fully generated (hw=r). Reset = disabled,
    //      i.e. every fragment passes. ----
    scissor_x_reg_t scissor_x;
    scissor_y_reg_t scissor_y;

    // ---- Load/store base — fully generated (hw=r). Reset 0. ----
    ls_base_reg_t ls_base;

    // ---- Sampler configuration — fully generated (hw=r). Reset = NEAREST. ----
    sampler_cfg_reg_t sampler_cfg;

    // ---- Performance counters: present-phase decomposition ----
    // Fully generated (hw=w → Borg drives io.hw.perf_*_value, SW reads).
    perf_counter_reg_t perf_total;   // 0x2AC: sequencer-active cycles (present total)
    perf_counter_reg_t perf_frag;    // 0x2B0: shader core running (vert+setup+frag)
    perf_counter_reg_t perf_flush;   // 0x2B4: tile flusher active (SDRAM writes)
    perf_counter_reg_t perf_stall;   // 0x2B8: gpuMem.req && !ready (SDRAM stall)
    perf_counter_reg_t perf_dma;     // 0x2BC: DMA active (bin/descriptor reads)

    // ---- Compute dispatch -- all nogen, decoded in Borg.scala only when
    //      BorgConfig.computeEnabled, so a build without compute (Wafer)
    //      carries no storage for them. ----
    compute_ctrl_reg_t compute_ctrl;
    compute_ctrl->nogen = true;
    compute_pc_reg_t compute_pc;
    compute_pc->nogen = true;
    compute_groups_xy_reg_t compute_groups_xy;
    compute_groups_xy->nogen = true;
    compute_groups_z_reg_t compute_groups_z;
    compute_groups_z->nogen = true;
    compute_local_reg_t compute_local;
    compute_local->nogen = true;

    // ---- Multi-texture binding: 4 base-address slots, FTEX rs3-selected ----
    tex_base_addr_reg_t tex_base_addr0;
    tex_base_addr_reg_t tex_base_addr1;
    tex_base_addr_reg_t tex_base_addr2;
    tex_base_addr_reg_t tex_base_addr3;

    // ---- Colour attachment format (RGB565 / RGBA8 / BGRA8) ----
    flush_format_reg_t flush_format;

    // ---- Shader program image for the instruction cache ----
    code_base_reg_t code_base;
    code_base->nogen = true;

    // ---- Occlusion queries ----
    occ_ctrl_reg_t occ_ctrl;
    occ_ctrl->nogen = true;
    occ_tri_range_reg_t occ_tri_range;
    occ_tri_range->nogen = true;
    occ_count_reg_t occ_count;
    occ_count->nogen = true;
};
