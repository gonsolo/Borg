    } z[16] = 0;

    field {
        sw = rw; hw = r;
        desc = "Bits 31:16: B channel (FP16) of clear color.";
    } b[16] = 0;
};

// --- Sequencer: clear color high word (Step 31) ---
reg seq_clear_hi_reg_t {
    name = "Sequencer Clear Color High";
    desc = "Packed {R[31:16], G[15:0]} clear color for tile buffer pre-fill.
            nogen: decoded in Borg.scala.";

    field {
        sw = rw; hw = r;
        desc = "Bits 15:0: G channel (FP16) of clear color.";
    } g[16] = 0;

    field {
        sw = rw; hw = r;
        desc = "Bits 31:16: R channel (FP16) of clear color.";
    } red[16] = 0;
};

// --- Sequencer: Framebuffer base address (Step 31.4) ---
reg seq_fb_base_reg_t {
    name = "Sequencer Framebuffer Base Address";
    desc = "20-bit DRAM byte address of the framebuffer.
            Used by the sequencer to dynamically compute the flush base address
            during autonomous tile iteration.  nogen: decoded in Borg.scala.";

    field {
