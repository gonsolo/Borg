// --- Vertex Sequencer: setup shader DRAM address (Step 29.2) ---
reg seq_setup_addr_reg_t {
    name = "Sequencer Setup Shader Address";
    desc = "20-bit DRAM byte address of the triangle setup shader binary.
            The sequencer DMA-loads this shader into IMEM after vertex shading
            to compute edge vectors and inv_area.  nogen: decoded in Borg.scala.";

