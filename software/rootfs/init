#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mount -t tmpfs none /dev

# The kernel logs "unable to open an initial console" on this platform (no
# /dev/console alias for the SBI hvc console at the point kernel_init()
# tries to open it), so PID 1 inherits closed/unusable stdio -- /bin/sh
# would read immediate EOF and exit, panicking with "Attempted to kill
# init!". Attach explicitly to the real console device instead.
exec </dev/hvc0 >/dev/hvc0 2>&1

echo ""
echo "Borg/Hutt Linux initramfs — welcome."
echo ""

# Bisecting a real-hardware-only hang (task #15, Bug A). Deep printk
# bisection localized the race to vfs_statx's path-walk, triggerable on
# essentially any qualifying path lookup. ftrace was tried and abandoned
# as a debugging tool here (5 straight attempts across 2 sessions all
# hung during ftrace's OWN setup; the one attempt that reached the
# function_graph tracer switch caused a harder, whole-system freeze --
# likely a separate ftrace/icache-coherency bug, not Bug A itself). This
# plain version carries no ftrace/printk instrumentation at all, for
# statistical repeat-boot characterization of the real hang rate.
echo "=== T1: ls /bin | cat (piped -- stdout not a tty, skips width ioctl) ==="
ls /bin | cat
echo "=== T1 end ==="
echo "=== T2: ls /bin (direct to console -- the known hang point, for direct comparison) ==="
ls /bin
echo "=== T2 end ==="

# Task #15 follow-up: now that boot completes (Bug A fixed) and T1/T2's
# slowness is understood to be execve()'s own address-space-teardown cost
# (not a hang), check whether STEADY-STATE syscalls on an already-running
# process (getpid, mmap/munmap -- shaped like what a DRM ioctl/GEM-mmap
# workload would look like) are similarly slow, or whether execve()'s cost
# is a one-time outlier. This directly informs whether a native Linux DRM
# driver on this platform is viable before investing in writing one.
echo "=== T3: /bin/bench (steady-state getpid/mmap syscall cost, not execve) ==="
/bin/bench
echo "=== T3 end ==="

exec /bin/sh
