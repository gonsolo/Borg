#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mount -t tmpfs none /dev

# The kernel logs "unable to open an initial console" on this platform (no
# /dev/console alias for the SBI hvc console at the point kernel_init()
# tries to open it), so PID 1 inherits closed/unusable stdio -- /bin/sh
# would read immediate EOF and exit, panicking with "Attempted to kill
# init!". Attach explicitly to the real console device instead.
exec </dev/hvc0 >/dev/hvc0 2>&1

echo ""
echo "Borg/Hutt Linux initramfs — welcome."
echo ""

# Step 5: the captured vkcube frame through the Borg DRM render node (/dev/dri/renderD128);
# the frame goes to the console as hex (scripts/uart_ppm.py turns it into a picture).
echo "=== borg_drm_test ==="
/bin/borg_drm_test
# Step 7: the unmodified cube.c on borgvk, headless; the frame goes to the console as hex.
echo "=== vkcube-borg ==="
export BORGVK_HW=1 BORGVK_SHADER_CACHE=/etc/cube.shaders BORGVK_DUMP_PPM=/tmp/frame.ppm
echo "uptime before: $(cat /proc/uptime)"
/bin/vkcube-borg --wsi display --c 1 --suppress_popups
echo "uptime after: $(cat /proc/uptime)"
echo "=== vkcube-borg end: $? ==="
echo PPM-BEGIN
od -An -v -tx1 /tmp/frame.ppm
echo PPM-END

exec /bin/sh
