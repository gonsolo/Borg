# Borg SoC OpenSBI platform Kconfig.
#
# platform.c uses the FDT-based generic drivers (fdt_serial_init,
# fdt_timer_init, fdt_ipi_init) to discover the CLINT (timer + IPI) from
# the embedded borg.dts. The debug UART node is status="disabled" in the
# DTS (OpenSBI talks to it directly via a hand-written console driver
# registered in early_init), so FDT_SERIAL is selected only for the
# framework — no FDT_SERIAL_* concrete driver is needed.

config PLATFORM_BORG
	bool
	select FDT
	select FDT_TIMER
	select FDT_TIMER_MTIMER
	select FDT_IPI
	select FDT_IPI_MSWI
	select FDT_SERIAL
	default y
