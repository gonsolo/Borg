# shader_blobs.h — the firmware's standalone shader pipeline.
#
#   vert_borg / frag_borg   GENERATED by borgc-cli from Vulkan-Tools' cube.vert
#                           and cube.frag: the same shaders borgvk compiles at
#                           submit time, through the same compiler and the same
#                           NIR pass list (borg_nir_passes.c is shared).
#   rasterize_borg          NOT generated. Hand-written Borg ISA (rasterize.s),
#                           and there is no assembler for it in-tree.
#
# Regeneration is an explicit target, not part of the default build: it needs a
# built Mesa tree for borgc-cli, and the firmware build should not drag that in.
# The generated header is checked in.
#
#   make regen BORGC_CLI=/path/to/mesa-build/src/borg/compiler/borgc-cli
#
# Why it exists at all: the previous generation of these blobs came from a
# glslangValidator -> spirv-dis -> python pipeline that was deleted along with
# its GLSL sources. The artifact could not be rebuilt, and had already gone
# silently stale against a wire-format change before anyone noticed. A blob you
# cannot regenerate is a blob you cannot trust.

CUBE     ?= ../../../Vulkan-Tools/cube
BORGC_CLI ?=
GLSLANG  ?= glslangValidator
TMP      := $(CURDIR)/.regen

all:
	@test -f shader_blobs.h || \
	  (echo "ERROR: shader_blobs.h missing — regenerate with 'make regen'" && exit 1)

regen:
	@test -n "$(BORGC_CLI)" || \
	  (echo "ERROR: set BORGC_CLI=<mesa-build>/src/borg/compiler/borgc-cli" && exit 1)
	@test -f "$(CUBE)/cube.vert" || \
	  (echo "ERROR: $(CUBE)/cube.vert missing — git submodule update --init Vulkan-Tools" && exit 1)
	@mkdir -p $(TMP)
	$(GLSLANG) -V $(CUBE)/cube.vert -o $(TMP)/cube_vert.spv
	$(GLSLANG) -V $(CUBE)/cube.frag -o $(TMP)/cube_frag.spv
	$(BORGC_CLI) -s vert -n vert_borg -H $(TMP)/gen_vert.h $(TMP)/cube_vert.spv
	$(BORGC_CLI) -s frag -n frag_borg -H $(TMP)/gen_frag.h $(TMP)/cube_frag.spv
	python3 merge_blobs.py $(TMP)/gen_vert.h $(TMP)/gen_frag.h shader_blobs.h
	@rm -rf $(TMP)
	@echo "regenerated shader_blobs.h — run 'make -C .. test-native' to check it"

# Push-constant lowering check (Step 50 item 13) — no simulator, no hardware.
#
# Asserts that borgc turns `layout(offset = 32)` in testdata/pushconst.frag
# into RAW WORD INDICES 8..11 pinned in const registers, because that single
# fact is what the whole feature rests on: the hardware forms
# LS_BASE + (rs1 << 2), so an index that got float-converted, or computed in
# bytes instead of words, addresses the wrong DRAM entirely. Cheap enough to
# run on every compiler change, unlike the simulator tests.
#
# Deliberately checks the ISA dump rather than just a clean exit: the shader
# compiling proves nothing here, since a wrong-but-well-formed index compiles
# exactly as happily as a right one.
test-pushconst:
	@test -n "$(BORGC_CLI)" || \
	  (echo "ERROR: set BORGC_CLI=<mesa-build>/src/borg/compiler/borgc-cli" && exit 1)
	@mkdir -p $(TMP)
	@$(GLSLANG) -V testdata/pushconst.vert -o $(TMP)/pc_vert.spv > /dev/null
	@$(GLSLANG) -V testdata/pushconst.frag -o $(TMP)/pc_frag.spv > /dev/null
	@$(BORGC_CLI) -s vert -o $(TMP)/pc_vert.borg $(TMP)/pc_vert.spv > /dev/null 2>&1
	@BORGC_DUMP_ISA=1 $(BORGC_CLI) -s frag -o $(TMP)/pc_frag.borg $(TMP)/pc_frag.spv \
	   > $(TMP)/frag.log 2>&1
	@grep -q 'r17=0x0008 r18=0x0009 r19=0x000a r20=0x000b' $(TMP)/frag.log || \
	  (echo "FAIL: offset=32 did not lower to word indices 8..11"; \
	   grep 'const regs' $(TMP)/frag.log; rm -rf $(TMP); exit 1)
	@echo "push-constant lowering OK: offset 32 -> word indices 8..11 (raw, not float)"
	@rm -rf $(TMP)

clean:
	rm -rf $(TMP)

.PHONY: all regen clean test-pushconst
