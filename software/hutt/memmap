MEMORY
{
    rom(rx)   : ORIGIN = 0x0,       LENGTH = 0x1000000
    ram_a(rw) : ORIGIN = 0x1000000, LENGTH = 0x0800000
    ram_b(rw) : ORIGIN = 0x1800000, LENGTH = 0x0800000
}
SECTIONS
{
    .boot : { *(.boot)
        KEEP (*(.boot))
    } > rom
    .srodata : { *(.srodata*) } > rom
    .early_text : { *(.early_text*) } > rom
    .text : { *(.text*) } > rom
    .rodata : { *(.rodata*) } > rom

    /* Load addresses (LMA) in ROM must be word-aligned: __runtime_init copies
       .peri and .data with uint32_t pointer walks, and a word read from an
       odd byte address returns the halfword containing it -- shifting every
       initialized variable by a byte (back_buf = 1 read back as 0x100). The
       end of .rodata is wherever the code size leaves it, so align here. */
    .peri : AT(ALIGN(LOADADDR(.rodata) + SIZEOF(.rodata), 16)) {
        . = ALIGN(4);
        __peri_data_start__ = .;
        *(.peri_data*)
        . = ALIGN(4);
        __peri_data_end__ = .;
        *(.peri_bss*)
    } > ram_a
    __peri_lma = LOADADDR(.peri);

    .data : AT(ALIGN(LOADADDR(.peri) + SIZEOF(.peri), 16)) {
        __data_start_unaligned__ = .;
        . = ALIGN(16);
        __data_start__ = .;
        *(.sdata*) *(.data*)
        . = ALIGN(16);
        __data_end__ = .;
    } > ram_a
    __data_lma = LOADADDR(.data) + __data_start__ - __data_start_unaligned__;

    .bss (NOLOAD): {
        . = ALIGN(16);
        __bss_start__ = .;
        *(.sbss*) *(.bss*)
        . = ALIGN(16);
        __bss_end__ = .;
    } > ram_a

    .uninitialized_data (NOLOAD): {
        . = ALIGN(16);
        *(.uninitialized_data*)
    } > ram_a

    /* Mark the end of all firmware-owned DRAM.  Hardware resources
       (texture, framebuffer) must be placed AFTER this address.       */
    __firmware_ram_end__ = .;

    .heap (NOLOAD):
    {
        . = ALIGN(4);
        __HeapStart = .;
        KEEP(*(.heap*))
        __HeapLimit = .;
    } > ram_b

    __global_pointer$ = 0x1000400;
    __StackTop = ORIGIN(ram_a) + LENGTH(ram_a);
    __StackLimit = __StackTop - 0x1000;
    ASSERT(__StackLimit >= __firmware_ram_end__, "region RAM overflowed")

    /* Guard: firmware RAM end must not reach the texture region.
       TEX_SPI_BYTE_ADDR is injected via -Wl,--defsym from borg_layout.h
       (TEX_DRAM_BYTE_ADDR_FIXED) by the Makefile — single source of truth.
       CPU texture address = ORIGIN(ram_a) + TEX_SPI_BYTE_ADDR.           */
    ASSERT(__firmware_ram_end__ <= ORIGIN(ram_a) + TEX_SPI_BYTE_ADDR,
           "FIRMWARE BSS/DATA OVERFLOWS INTO TEXTURE REGION! Increase TEX_SPI_BYTE_ADDR or shrink firmware data.")
}
