+	/* Unconditional (not just on a real page change): the initial page is
+	 * assigned directly by pps_view_presentation_set_current_page() before
+	 * the widget is realized, so the first call here that has a valid size
+	 * to allocate into may see priv->current_page == page already. */
+	pps_view_presentation_sync_media (pview, page);
+	if (gtk_widget_get_width (GTK_WIDGET (pview)) > 0)
+		pps_view_presentation_allocate_media (pview);
+
 	if (priv->page_cache)
 		pps_page_cache_set_page_range (priv->page_cache, page, page);
 
@@ -854,6 +976,7 @@ pps_view_presentation_dispose (GObject *object)
 	g_clear_object (&priv->previous_texture);
 
 	g_clear_pointer (&priv->goto_popup, gtk_widget_unparent);
+	g_clear_pointer (&priv->media_player, gtk_widget_unparent);
 
 	g_clear_handle_id (&priv->trans_timeout_id, g_source_remove);
 	g_clear_handle_id (&priv->hide_cursor_timeout_id, g_source_remove);
@@ -1094,6 +1217,9 @@ pps_view_presentation_snapshot (GtkWidget *widget, GtkSnapshot *snapshot)
 	}
 
 	gsk_render_node_unref (document_node);
+
+	if (priv->media_player)
+		gtk_widget_snapshot_child (widget, priv->media_player, snapshot);
 }
 
 static gboolean
@@ -1381,6 +1507,8 @@ pps_view_presentation_size_allocate (GtkWidget *widget,
 
 	if (priv->goto_popup)
 		gtk_popover_present (GTK_POPOVER (priv->goto_popup));
+
+	pps_view_presentation_allocate_media (pview);
 }
 
