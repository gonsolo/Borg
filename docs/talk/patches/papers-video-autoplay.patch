+/* Media (Movie/Screen+Rendition annotations) */
+static void
+pps_view_presentation_clear_media (PpsViewPresentation *pview)
+{
+	PpsViewPresentationPrivate *priv = GET_PRIVATE (pview);
+
+	g_clear_pointer (&priv->media_player, gtk_widget_unparent);
+}
+
+/* Swap in whatever media belongs to `page`, replacing any player left over
+ * from the previous page. Positioning happens in size_allocate (the
+ * page-space -> widget-space transform needs the widget's current size). */
+static void
+pps_view_presentation_sync_media (PpsViewPresentation *pview,
+                                  guint page)
+{
+	PpsViewPresentationPrivate *priv = GET_PRIVATE (pview);
+	PpsMappingList *media_mapping;
+	PpsPage *pps_page;
+	GList *l;
+	PpsMedia *media = NULL;
+	PpsMapping *found = NULL;
+
+	pps_view_presentation_clear_media (pview);
+
+	if (!priv->document || !PPS_IS_DOCUMENT_MEDIA (priv->document))
+		return;
+
+	pps_page = pps_document_get_page (priv->document, page);
+	media_mapping = pps_document_media_get_media_mapping (PPS_DOCUMENT_MEDIA (priv->document), pps_page);
+	g_object_unref (pps_page);
+
+	for (l = media_mapping ? pps_mapping_list_get_list (media_mapping) : NULL; l; l = l->next) {
+		found = l->data;
+		media = found->data;
+		break; /* one media widget per page is enough for our use case */
+	}
+
+	if (!media) {
+		if (media_mapping)
+			pps_mapping_list_unref (media_mapping);
+		return;
+	}
+
+	/* The mapping list holds the sole ref on `media` (see
+	 * pdf_document_media_get_media_mapping) -- take our own before
+	 * dropping the list, since we don't keep the list itself around. */
+	media = g_object_ref (media);
+	priv->media_area = found->area;
+	pps_mapping_list_unref (media_mapping);
+
+	/* gtk_video_set_loop()'s own docs: "This won't affect the file that is
+	 * currently being played" -- it only takes effect for files loaded
+	 * *after* the call. Set autoplay/loop on an empty GtkVideo first, then
+	 * load the file, so both actually apply to it. */
+	priv->media_player = gtk_video_new ();
+	gtk_video_set_autoplay (GTK_VIDEO (priv->media_player), TRUE);
+	gtk_video_set_loop (GTK_VIDEO (priv->media_player), TRUE);
+	{
+		GFile *file = g_file_new_for_uri (pps_media_get_uri (media));
+		gtk_video_set_file (GTK_VIDEO (priv->media_player), file);
+		g_object_unref (file);
+	}
+	gtk_widget_set_parent (priv->media_player, GTK_WIDGET (pview));
+
+	/* For an embedded (temp-file-backed) media, `media`'s finalize deletes
+	 * that temp file (see pps_media_from_poppler_rendition's
+	 * "poppler-media-temp-file" qdata) -- dropping our ref here, before
+	 * GStreamer has actually opened the file asynchronously, deletes it out
+	 * from under the player ("gtk_gst_media_file_source_setup_cb: assertion
+	 * 'stream != NULL' failed"). Keep `media` alive for the player's
+	 * lifetime instead, mirroring pps_view_handle_media()'s same pattern in
+	 * pps-view.c. */
+	g_object_set_data_full (G_OBJECT (priv->media_player), "media",
+	                        media, (GDestroyNotify) g_object_unref);
+}
+
+/* Position the media player (if any) over its annotation's rect on the
+ * current page. Rotation is intentionally not handled here -- only
+ * rotation 0 is exercised by our use case (a title-slide video). */
+static void
+pps_view_presentation_allocate_media (PpsViewPresentation *pview)
+{
+	PpsViewPresentationPrivate *priv = GET_PRIVATE (pview);
+	GdkRectangle page_area;
+	gdouble width, height, scale;
+	GtkAllocation alloc;
+
+	if (!priv->media_player)
+		return;
+
+	pps_view_presentation_get_page_area (pview, &page_area);
+	pps_document_get_page_size (priv->document, priv->current_page, &width, &height);
+	if (priv->rotation == 90 || priv->rotation == 270) {
+		gdouble tmp = width;
+		width = height;
+		height = tmp;
+	}
+	scale = width > 0 ? page_area.width / width : 1.0;
+
+	alloc.x = page_area.x + (int) (priv->media_area.x1 * scale + 0.5);
+	alloc.y = page_area.y + (int) (priv->media_area.y1 * scale + 0.5);
+	alloc.width = (int) ((priv->media_area.x2 - priv->media_area.x1) * scale + 0.5);
+	alloc.height = (int) ((priv->media_area.y2 - priv->media_area.y1) * scale + 0.5);
+
+	gtk_widget_size_allocate (priv->media_player, &alloc, -1);
+}
+
 /* Page Transition */
 static void
 transition_next_page (PpsViewPresentation *pview)
@@ -515,6 +629,14 @@ pps_view_presentation_update_current_page (PpsViewPresentation *pview,
