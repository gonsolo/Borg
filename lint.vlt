`verilator_config

lint_off -rule UNUSEDSIGNAL -file "*MulAddRecFN*.sv"
lint_off -rule UNUSEDSIGNAL -file "*RoundAnyRawFNToRecFN*.sv"
lint_off -rule UNUSEDSIGNAL -file "*RoundRawFNToRecFN*.sv"
lint_off -rule UNUSEDSIGNAL -file "*Borg.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgGpuRegs.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgCore.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgLane.sv"
lint_off -rule UNUSEDSIGNAL -file "*Shifter.sv"
lint_off -rule UNUSEDSIGNAL -file "*Time.sv"
lint_off -rule UNUSEDSIGNAL -file "*Cpu.sv"
lint_off -rule UNUSEDSIGNAL -file "*Core.sv"
lint_off -rule UNUSEDSIGNAL -file "*tt_um_gonsolo_borg.sv"
lint_off -rule PINMISSING   -file "*tt_um_gonsolo_borg.sv"
lint_off -rule UNUSEDSIGNAL -file "*MemoryController.sv"
lint_off -rule UNUSEDSIGNAL -file "*tqvp_uart_wrapper.sv"
lint_off -rule PINCONNECTEMPTY -file "*Time.sv"
lint_off -rule PINCONNECTEMPTY -file "*Core.sv"
lint_off -rule PINMISSING -file "*Cpu.sv"
lint_off -rule UNUSEDSIGNAL -file "*TinyQV.sv"
lint_off -rule UNUSEDSIGNAL -file "*TinyQVDecode.sv"
lint_off -rule UNUSEDSIGNAL -file "*Fp16Rcp.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgRasterizer*.sv"
lint_off -rule UNUSEDSIGNAL -file "*rgbzMem*.sv"
lint_off -rule UNUSEDSIGNAL -file "*ram_*.sv"
lint_off -rule UNUSEDSIGNAL -file "*tagMem*.sv"
lint_off -rule UNUSEDSIGNAL -file "*dataMem*.sv"
lint_off -rule PINCONNECTEMPTY -file "*Borg.sv"
lint_off -rule UNUSEDSIGNAL -file "*tt_um_gonsolo_borg_sim.sv"
lint_off -rule UNUSEDSIGNAL -file "*MemoryControllerSim.sv"
lint_off -rule UNUSEDSIGNAL -file "*sim_mem_*.sv"
lint_off -rule UNUSEDSIGNAL -file "*QspiControllerSim.sv"
lint_off -rule UNUSEDSIGNAL -file "*QspiController.sv"
lint_off -rule UNDRIVEN -file "*coordLut*.sv"
lint_off -rule UNDRIVEN -file "*rcpLut*.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgFp16Fma.sv"
lint_off -rule UNUSEDSIGNAL -file "*Fp16Rsq.sv"
lint_off -rule UNUSEDSIGNAL -file "*Fp16Srgb.sv"
lint_off -rule UNDRIVEN     -file "*frsqLut*.sv"
lint_off -rule UNDRIVEN     -file "*srgbLut*.sv"
// Async-read Mem LUTs (rcp/frsq/srgb) emit per-read-port R0_clk/R1_clk that a
// combinational read does not use — firtool emits the clock port regardless.
lint_off -rule UNUSEDSIGNAL -file "*rcpLut*.sv"
lint_off -rule UNUSEDSIGNAL -file "*frsqLut*.sv"
lint_off -rule UNUSEDSIGNAL -file "*srgbLut*.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgTileFlusher.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgSequencer.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgBinner.sv"
lint_off -rule UNUSEDSIGNAL -file "*countMem*.sv"
lint_off -rule UNUSEDSIGNAL -file "*BorgShaderDispatcher.sv"
lint_off -rule UNUSEDSIGNAL -file "*Hutt.sv"
lint_off -rule UNUSEDSIGNAL -file "*HuttAlu.sv"
lint_off -rule PINCONNECTEMPTY -file "*Peripherals.sv"
lint_off -rule UNUSEDSIGNAL -file "*Clint.sv"
// HuttRegFile's register file: two 16-entry Mem halves (matching ECP5's
// native TRELLIS_DPR16X4 primitive depth) instead of one Mem(32, ...) --
// same async-read-clock-port-unused pattern as the LUTs above. Generated
// blackbox name depends on xlen (mem_16x32 for RV32 ASIC/TT, mem_16x64
// for RV64 ULX3S).
lint_off -rule UNUSEDSIGNAL -file "*mem_16x32*.sv"
lint_off -rule UNUSEDSIGNAL -file "*mem_16x64*.sv"
